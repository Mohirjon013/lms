generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  TEACHER
  ASSISTANT
  STUDENT
}

enum CourseLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  ADVANCED
}

enum PaidVia {
  PAYME
  CLICK
  CASH
}

enum Answer {
  variantA
  variantB
  variantC
  variantD
}

enum HomeworkSubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Status {
  ACTIVE
  INACTIVE
  FREEZE
}

enum PaymentStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  NEW_QUESTION
  NEW_ANSWER
  NEW_HOMEWORK_SUBMISSION
  HOMEWORK_REVIEWED
  SYSTEM_MESSAGE
}

model User {
  id         Int      @id @default(autoincrement())
  full_name  String
  phone      String   @unique
  password   String
  email      String?
  file       String?
  role       UserRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  teacherProfile      TeacherProfile?
  courses             Courses[]
  purchasedCourses    PurchasedCourse[]
  ratings             Rating[]
  lastActivity        LastActivity?
  homeworkSubmissions HomeworkSubmission[]
  testResults         TestResult[]
  lessonViews         LessonView[]
  notifications       Notification[]
  lessonRatings       LessonRating[]
  questions           Question[]
  questionAnswers     QuestionAnswer[]

  @@map("user")
}

model TeacherProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  experience  Float?
  job         String?
  website     String?
  description String?
  facebook    String?
  telegram    String?
  linkedin    String?
  instagram   String?
  github      String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Courses[]

  @@map("teacher_profile")
}

