model Categories {
  id   Int    @id @default(autoincrement())
  name String @unique

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  courses    Courses[]

  @@map("categories")
}

model Courses {
  id           Int         @id @default(autoincrement())
  assistantId  Int?
  teacherId    Int
  name         String
  banner       String
  intro_video  String
  description  String
  price        Decimal
  level        CourseLevel
  status       Status      @default(INACTIVE)
  categoriesId Int
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  categories       Categories        @relation(fields: [categoriesId], references: [id], onDelete: Cascade)
  assistant        User?             @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  teacher_profile  TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sections         Sections[]
  purchasedCourses PurchasedCourse[]
  ratings          Rating[]

  @@map("courses")
}

model PurchasedCourse {
  userId      Int
  courseId    Int
  amount      Decimal?
  paidVia     PaidVia?
  status      PaymentStatus @default(PENDING)
  purchasedAt DateTime      @default(now())
  user        User          @relation(references: [id], fields: [userId], onDelete: Cascade)
  course      Courses       @relation(references: [id], fields: [courseId], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("purchased_course")
}

model Sections {
  id         Int      @id @default(autoincrement())
  name       String
  coursesId  Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  course  Courses   @relation(fields: [coursesId], references: [id], onDelete: Cascade)
  lessons Lessons[]

  @@unique([coursesId, name])
  @@map("sections")
}

model Rating {
  id         Int      @id @default(autoincrement())
  rate       Int
  comment    String
  courseId   Int
  userId     Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  course Courses @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId]) // bir student bir kursga 1 sharh (ko'p bo'lsa olib tashla)
  @@map("rating")
}

model LastActivity {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  courseId   Int?
  sectionId  Int?
  lessonId   Int?
  url        String?
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("last_activity")
}

model Lessons {
  id          Int      @id @default(autoincrement())
  name        String
  sectionsId  Int
  description String
  file        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  section       Sections       @relation(fields: [sectionsId], references: [id], onDelete: Cascade)
  materials     Materials[]
  homeworks     Homeworks[]
  tests         Tests[]
  testResults   TestResult[]
  lessonViews   LessonView[]
  lessonRatings LessonRating[]
  questions     Question[]

  @@unique([sectionsId, name])
  @@map("lessons")
}

// Dars reytingi (faqat yulduz). Video ostidagi "Darsni baholash".
model LessonRating {
  id         Int      @id @default(autoincrement())
  rate       Int
  lessonId   Int
  userId     Int
  created_at DateTime @default(now())

  lesson Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId]) // bir user bir darsga 1 marta baho
  @@map("lesson_rating")
}

// Kim qaysi darsni tugatgan (chap paneldagi ✓ belgisi)
model LessonView {
  lessonId Int
  userId   Int
  view     Boolean @default(true)

  lesson Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([lessonId, userId]) // bir user + bir dars = bitta qator
  @@map("lesson_view")
}

model Materials {
  id          Int      @id @default(autoincrement())
  lessonsId   Int
  description String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  lessons Lessons         @relation(fields: [lessonsId], references: [id], onDelete: Cascade)
  files   MaterialFiles[]

  @@map("materials")
}

model MaterialFiles {
  id          Int    @id @default(autoincrement())
  materialsId Int
  file        String

  materials Materials @relation(fields: [materialsId], references: [id], onDelete: Cascade)

  @@map("material_files")
}

model Homeworks {
  id         Int      @id @default(autoincrement())
  lessonsId  Int
  title      String
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lessons             Lessons              @relation(fields: [lessonsId], references: [id], onDelete: Cascade)
  homeworkSubmissions HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id         Int               @id @default(autoincrement())
  text       String?
  file       String
  reason     String? // rad etilsa — sababi
  status     HomeworkSubStatus @default(PENDING)
  homeworkId Int
  userId     Int
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  homework Homeworks @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("homework_submission")
}

model Tests {
  id        Int    @id @default(autoincrement())
  lessonsId Int
  question  String
  variantA  String
  variantB  String
  variantC  String
  variantD  String
  answer    Answer

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lessons Lessons @relation(fields: [lessonsId], references: [id], onDelete: Cascade)

  @@map("tests")
}

model TestResult {
  id         Int      @id @default(autoincrement())
  lessonsId  Int
  userId     Int
  passed     Boolean
  corrects   Int
  wrongs     Int
  created_at DateTime @default(now())

  lessons Lessons @relation(fields: [lessonsId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("test_result")
}

// Student dars bo'yicha savol beradi. Admin "Savollar" ekrani.
model Question {
  id         Int       @id @default(autoincrement())
  userId     Int // kim so'radi (student)
  lessonId   Int // qaysi dars bo'yicha
  text       String
  file       String?
  read       Boolean   @default(false) // admin ko'rdimi ("O'qilgan")
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lessons         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answer QuestionAnswer?

  @@map("question")
}

// Mentor/assistant savolga javob beradi.
model QuestionAnswer {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique // 1 savol = 1 javob (one-to-one)
  userId     Int // kim javob berdi
  text       String
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("question_answer")
}

// Bildirishnoma. entityType+entityId = polimorfik pointer (turli jadvalga ishora)
model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       NotificationType
  message    String
  entityType String? // "question" | "homework_submission" | ...
  entityId   Int? // tegishli yozuv id'si (havola qurish uchun)
  read       Boolean          @default(false)
  read_at    DateTime?
  created_at DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read]) // o'qilmagan sonini tez sanash uchun
  @@index([userId, created_at]) // vaqt bo'yicha tez saralash uchun
  @@map("notification")
}
